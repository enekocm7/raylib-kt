# Kotlin/Native cinterop definition for raylib.
#
# The raylib header is vendored in cinterop/include/raylib.h. Amper automatically
# adds that directory to the compiler include path, so `headers` can reference
# the header by its plain name and no system raylib headers are required.

package = raylib

headers = raylib.h raymath.h rlgl.h
headerFilter = raylib.h raymath.h rlgl.h

staticLibraries.linux = libraylib.a libraylib.so
staticLibraries.mingw = libraylibdll.a libraylib.a raylib.dll

# Link against a system-installed raylib. Install it via your platform's package
# manager and keep the platform dependencies below as-is.
linkerOpts.linux = -lraylib -lm -lpthread -ldl -lrt -lX11 -lGL
linkerOpts.osx = -lraylib -framework OpenGL -framework Cocoa -framework IOKit -framework CoreVideo -framework CoreAudio -framework CoreAudioKit
linkerOpts.mingw = -lraylib -lopengl32 -lgdi32 -lwinmm

userSetupHint = Install raylib (Linux: `apt install libraylib-dev`; macOS: `brew install raylib`; Windows/MSYS2: `pacman -S mingw-w64-x86_64-raylib`) and make sure `libraylib` is on the linker search path.
